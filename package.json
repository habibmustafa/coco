{
  "name": "coco",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/coco.cjs",
  "module": "./dist/coco.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/coco.js",
      "require": "./dist/coco.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build:lib": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:classes": "node scripts/check-classes.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test": "vitest run",
    "verify": "npm run build:lib && npm run lint && npm run check:classes && npm run check:tokens && npm run test"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.23",
    "framer-motion": "^11.18.2",
    "highlightjs-curl": "^1.3.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^9.14.0",
    "react-hook-form": "^7.88.0",
    "react-resizable-panels": "^4.13.2",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@hookform/resolvers": "^3.10.0",
    "@microsoft/api-extractor": "^7.59.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.1",
    "zod": "^3.25.76"
  }
}
